# =========================================================================
#  Le Comptoir des Structurés — configuration Apache (Hostinger)
#  Ce fichier ne concerne que le dossier /observatoire/ et n'affecte pas
#  le reste du site.
# =========================================================================

# --- Page d'erreur ------------------------------------------------------
ErrorDocument 404 /observatoire/404.html

# --- Redirections 301 : pages fusionnées en onglets ---------------------
<IfModule mod_alias.c>
  Redirect 301 /observatoire/familles.html https://www.lafinancierederochechouart.com/observatoire/comprendre.html#familles
  Redirect 301 /observatoire/glossaire.html https://www.lafinancierederochechouart.com/observatoire/comprendre.html#glossaire
  Redirect 301 /observatoire/emetteurs.html https://www.lafinancierederochechouart.com/observatoire/acteurs.html#emetteurs
  Redirect 301 /observatoire/etablissements.html https://www.lafinancierederochechouart.com/observatoire/acteurs.html#etablissements
</IfModule>

# --- Compression --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache navigateur ---------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Types MIME ---------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/xml .xml
</IfModule>
