# ─────────────────────────────────────────────────────────────
# Cronostic — variables d'environnement
#
# Le site démarre SANS aucune de ces variables : il bascule alors
# en « mode démo » (données de seed en mémoire, auth locale,
# paiement simulé, stockage disque). Chaque bloc ci-dessous
# active une brique réelle, indépendamment des autres.
# ─────────────────────────────────────────────────────────────

# Base — URL publique du site (liens Stripe, sitemap, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Neon PostgreSQL ──────────────────────────────────────────
# Sans cette variable : lecture depuis le seed en mémoire,
# écritures admin désactivées.
# postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/cronostic?sslmode=require
DATABASE_URL=

# ── Clerk (authentification) ─────────────────────────────────
# Sans ces variables : session de développement par cookie signé
# (page /connexion), suffisante pour tester les droits d'accès.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/connexion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/inscription

# Secret de signature du cookie de session en mode démo.
# Obligatoire en production si Clerk n'est pas configuré.
DEV_AUTH_SECRET=

# Emails administrateurs, séparés par des virgules.
ADMIN_EMAILS=

# ── Courriel transactionnel ──────────────────────────────────
# Adresse expéditrice et de contact affichée sur le site.
CONTACT_EMAIL=cronostic.info@gmail.com
# Envoi par SMTP. Pour Gmail : hôte smtp.gmail.com, port 465, utilisateur
# l'adresse complète, et un MOT DE PASSE D'APPLICATION — jamais le mot de
# passe du compte. Sans ces variables, les messages sont écrits dans les
# journaux du serveur au lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── Stripe ───────────────────────────────────────────────────
# Sans ces variables : le checkout est simulé (droits accordés
# immédiatement) pour pouvoir dérouler tout le parcours.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID récurrents, un par formule et par périodicité.
STRIPE_ATELIER_MENSUEL_PRICE_ID=
STRIPE_ATELIER_ANNUEL_PRICE_ID=
STRIPE_INTEGRAL_MENSUEL_PRICE_ID=
STRIPE_INTEGRAL_ANNUEL_PRICE_ID=

# Grille tarifaire, en centimes. Sert d'affichage, et de repli quand les
# Price ID ne sont pas renseignés.
#   Guide à l'unité        14,90 €  (saisi par guide dans /admin/guides)
#   Atelier   mensuel      19,90 €  — 5 guides par mois
#   Atelier   annuel      199,00 €  — deux mois offerts
#   Intégrale mensuel      29,90 €  — tous les guides
#   Intégrale annuel      299,00 €  — deux mois offerts
NEXT_PUBLIC_ATELIER_MENSUEL_CENTS=1990
NEXT_PUBLIC_ATELIER_ANNUEL_CENTS=19900
NEXT_PUBLIC_INTEGRAL_MENSUEL_CENTS=2990
NEXT_PUBLIC_INTEGRAL_ANNUEL_CENTS=29900
NEXT_PUBLIC_QUOTA_ATELIER=5

# ── Mesure d'audience ────────────────────────────────────────
# Sel des empreintes de visite. Une valeur aléatoire longue suffit :
#   openssl rand -hex 32
# Il n'est jamais exposé et ne permet pas de remonter à une adresse IP.
# Sans cette variable, un sel aléatoire est tiré au démarrage : la mesure
# fonctionne, mais les visites distinctes se recomptent après un redéploiement.
ANALYTICS_SALT=

# ── Cloudflare R2 (bucket PRIVÉ pour les PDF) ────────────────
# Sans ces variables : les PDF sont lus/écrits dans .local-storage/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cronostic
# Durée de validité des URLs signées de téléchargement, en secondes
R2_SIGNED_URL_TTL=300

# ── eBay Browse API (annonces de pièces détachées) ───────────
# SANS CES DEUX VARIABLES, AUCUNE ANNONCE NE PEUT ÊTRE AFFICHÉE.
# Créer un compte sur developer.ebay.com, puis Application keys →
# jeu de clés PRODUCTION (le Sandbox ne contient aucune annonce réelle).
#   App ID (Client ID)     → EBAY_CLIENT_ID
#   Cert ID (Client Secret) → EBAY_CLIENT_SECRET
# Vérification : ouvrir /admin/ebay, les trois voyants doivent être verts.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Place de marché interrogée : EBAY_FR, EBAY_GB, EBAY_US, EBAY_DE…
EBAY_MARKETPLACE_ID=EBAY_FR

# production (défaut) ou sandbox — le sandbox n'a pas d'annonces réelles.
EBAY_ENV=production

# Catégories de fournitures, séparées par des virgules. LAISSER VIDE :
# les identifiants diffèrent d'une place de marché à l'autre et une catégorie
# inconnue renvoie zéro résultat au lieu d'une erreur. Le tri des montres
# complètes se fait sur l'intitulé, ce qui fonctionne partout.
EBAY_CATEGORY_IDS=

# Annonces d'exemple, pour voir la mise en page sans clé d'API.
# Chaque annonce est fictive et signalée comme telle à l'écran.
# Ne jamais activer en production.
EBAY_DEMO=
